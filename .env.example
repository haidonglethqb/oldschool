DEBUG=True
SECRET_KEY=django-insecure-oldschool-dev-secret-key-change-in-production
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Database Configuration
# Lựa chọn 1: SQLite (Mặc định cho môi trường phát triển & kiểm thử nhanh)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Lựa chọn 2: PostgreSQL 16 (Khi triển khai Docker / Production)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=oldschool_db
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Central Warehouse Code
CENTRAL_WAREHOUSE_CODE=CS1
MAX_UPLOAD_SIZE_MB=10
